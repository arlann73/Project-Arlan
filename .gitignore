# ── 3-Layer Architecture (AGENTS.md) ──────────────────────
.env
.env.*
!.env.example

# Intermediate scratch & temp files — always regenerated, never commit
.tmp/
.scratch/
**/.scratch/

# Google OAuth tokens — sensitive
credentials.json
token.json

# Python
__pycache__/
*.py[cod]
*.pyo
.venv/
venv/
*.egg-info/
dist/
build/

# Node & Dependencies
node_modules/
**/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.npm
.eslintcache
.stylelintcache
*.tsbuildinfo

# Playwright & Testing artifacts
test-results/
playwright-report/
blob-report/
playwright/.cache/
playwright/.auth/
**/screenshot_*.png
**/screenshot_*.webp
coverage/
.nyc_output/

# OS & IDE
.DS_Store
Thumbs.db
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
